# ==============================================================================
# KONFIGURASI — salin file ini menjadi `.env` lalu isi nilainya.
# ==============================================================================
# PENTING: `.env` TIDAK BOLEH di-commit (sudah masuk .gitignore).
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
# 1. IDENTITAS SITUS
# ──────────────────────────────────────────────────────────────────────────────
# Alamat publik situs. Dipakai untuk membuat tautan QR & tautan video.
# Lokal: http://localhost:3000
# Produksi: https://domain-anda.com
SITUS_URL=http://localhost:3000

# Nama perusahaan (tampil di halaman)
NAMA_PERUSAHAAN=Cokelat Kita

# ──────────────────────────────────────────────────────────────────────────────
# 2. GOOGLE — AKSES AKUN PEMILIK (OAuth)  ← WAJIB untuk menyimpan video
# ──────────────────────────────────────────────────────────────────────────────
# KENAPA WAJIB, PADAHAL ADA SERVICE ACCOUNT DI BAWAH:
#   Service account TIDAK PUNYA KUOTA penyimpanan. Ia bisa membuat folder di
#   Drive Anda, tetapi berkas yang ia unggah dihitung ke kuotanya sendiri (0).
#   Hasilnya unggahan video GAGAL dengan HTTP 403:
#     "Service Accounts do not have storage quota"
#
#   Karena itu penyimpanan video memakai izin AKUN GOOGLE ANDA (OAuth).
#   Cara membuatnya: docs/SETUP_OAUTH.md (sekali saja, ~5 menit).
#
# Ambil tokennya dengan: npx tsx scripts/dapatkan_token_oauth.ts
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# 2b. GOOGLE SERVICE ACCOUNT (cadangan / opsional)
# ──────────────────────────────────────────────────────────────────────────────
# Boleh dibiarkan kosong bila OAuth di atas sudah diisi.
# Berguna untuk memeriksa folder & spreadsheet tanpa akses akun Anda.
# Cara membuat: lihat docs/SETUP_GOOGLE.md
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# 3. LOKASI PENYIMPANAN
# ──────────────────────────────────────────────────────────────────────────────
# ID folder Google Drive tempat semua video disimpan.
# Ambil dari URL folder: https://drive.google.com/drive/folders/<INI_ID_FOLDER>
# Folder ini HARUS dibagikan ke GOOGLE_CLIENT_EMAIL di atas sebagai Editor.
GOOGLE_DRIVE_FOLDER_ID=

# ID Google Sheets untuk mencatat pesanan (kode, nama, file video).
# Ambil dari URL spreadsheet: https://docs.google.com/spreadsheets/d/<INI_ID_SHEET>/edit
# Spreadsheet ini HARUS dibagikan ke GOOGLE_CLIENT_EMAIL di atas sebagai Editor.
# Baris pertama (judul kolom) harus persis:
#   kode | dibuat | nama_pembeli | nama_penerima | judul | pesan | folder_id | file_id | status
GOOGLE_SHEET_ID=

# Nama tab/lembar di dalam spreadsheet (biasanya "Sheet1")
GOOGLE_SHEET_TAB=Sheet1

# ──────────────────────────────────────────────────────────────────────────────
# 4. KEAMANAN
# ──────────────────────────────────────────────────────────────────────────────
# Kunci acak untuk menandatangani token video. WAJIB diisi, minimal 32 karakter.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ganti nilai ini akan membuat semua tautan video yang sedang aktif tidak berlaku.
TOKEN_SECRET=

# Berapa jam tautan video boleh dipakai setelah kode dimasukkan (default 2 jam)
TOKEN_MASA_BERLAKU_JAM=2

# ──────────────────────────────────────────────────────────────────────────────
# 4b. HALAMAN ADMIN (cetak QR)
# ──────────────────────────────────────────────────────────────────────────────
# PIN untuk membuka /admin — halaman tempat perusahaan mencetak QR kemasan.
# Minimal 6 karakter. Boleh angka, huruf, atau campuran.
#
# Buat PIN acak dengan: node -e "console.log(require('crypto').randomInt(100000,999999))"
#
# PENTING:
#   - Kosongkan = halaman admin DIMATIKAN total (tidak bisa diakses siapa pun).
#   - Jangan pakai PIN yang sama dengan akun lain.
#   - Mengganti PIN otomatis membatalkan semua sesi admin yang sedang berjalan.
ADMIN_PIN=

# Berapa jam sesi admin berlaku setelah PIN dimasukkan (default 8 jam)
ADMIN_SESI_JAM=8

# Batas percobaan memasukkan kode yang salah per alamat IP (default 20 / 15 menit)
BATAS_PERCOBAAN_KODE=20
JENDELA_PERCOBAAN_MENIT=15

# Batas pengiriman per alamat IP per hari (mencegah spam unggahan)
BATAS_KIRIM_PER_HARI=30

# Ukuran maksimal video yang diunggah (dalam MB)
MAKS_UKURAN_VIDEO_MB=200

# ──────────────────────────────────────────────────────────────────────────────
# 5. OPSIONAL — NOTIFIKASI
# ──────────────────────────────────────────────────────────────────────────────
# Bila diisi, setiap pesanan baru dikabari ke alamat email ini lewat Resend.
# Kosongkan bila tidak perlu.
RESEND_API_KEY=
EMAIL_NOTIFIKASI=
RESEND_FROM=Cokelat Kita <notifikasi@resend.dev>
